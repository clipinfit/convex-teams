{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/_generated",
      "!!**/dist",
      "!!**/.convex",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.source",
      "!!**/.turbo",
      "!!**/.vercel"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
