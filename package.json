{
  "name": "convex-teams-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:example": "bun run --cwd packages/example-backend dev",
    "codegen": "bun run --cwd packages/example-backend codegen",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pack:check": "bun run --cwd packages/convex-teams pack:check",
    "pack:smoke": "node scripts/smoke-package.mjs",
    "version:alpha": "cd packages/convex-teams && npm version prerelease --preid=alpha --no-git-tag-version && cd ../.. && bun install --lockfile-only",
    "check:links": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "turbo": "2.10.8"
  }
}
